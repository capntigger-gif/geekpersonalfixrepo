{
  "name": "kakarotextension",
  "description": "Personal Paperback extensions with a fixed League of Comic Geeks tracker.",
  "author": "Karrot",
  "keywords": [
    "Paperback",
    "extensions"
  ],
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capntigger-gif/geekpersonalfixrepo.git"
  },
  "bugs": {
    "url": "https://github.com/capntigger-gif/geekpersonalfixrepo/issues"
  },
  "homepage": "https://github.com/capntigger-gif/geekpersonalfixrepo#readme",
  "repositoryName": "Geek Personal Fix Repo",
  "repositoryDescription": "Personal Paperback extensions with a fixed League of Comic Geeks tracker.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsc": "tsc",
    "bundle": "paperback-cli bundle",
    "test": "npx --package @paperback/toolchain@1.0.0-alpha.78 paperback-cli test --noConsole --output ./bundles/tests.json",
    "serve": "paperback-cli serve",
    "logcat": "paperback-cli logcat --ip 192.168.1.65",
    "dev": "paperback-cli serve --watch --port 3000",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@paperback/toolchain": "1.0.0-alpha.91",
    "@paperback/types": "1.0.0-alpha.91",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
